# Copy to .env.config for local configuration. Keep real credentials out of source control.
# yfscreen discovers current equity symbols; yfinance retrieves headline data.
FINBOT_RESEARCH_PROVIDER=yfscreen
FINBOT_NEWS_PROVIDER=yfinance
FINBOT_NEWS_INTERVAL_SECONDS=3600
FINBOT_NEWS_SYMBOL_LIMIT=8
FINBOT_NEWS_TICKERS=AAPL,MSFT,NVDA,AMD,META,XOM
NEWS_API_BASE_URL=
NEWS_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_MODEL=gpt-4o-mini

# eToro requires both the public API key and the per-user key.
ETORO_API_BASE_URL=https://public-api.etoro.com
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
ETORO_MAIN_ACCOUNT_ID=
ETORO_DEMO_ACCOUNT_ID=
ETORO_DEMO_TRADING=true

FINBOT_BROKER_PROVIDER=dummy
FINBOT_PORTFOLIO_ACCOUNT_SOURCE=paper
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_DEMO_ACCOUNT_ID=
IBKR_MAIN_ACCOUNT_ID=
IBKR_ACCOUNT_ID=
IBKR_PAPER_TRADING=true

FINBOT_STARTING_CAPITAL=10000
FINBOT_USERNAME=admin
FINBOT_PASSWORD=admin123
ENABLE_HTTPS=false

# Optional disaster recovery for hosted deployments. The live SQLite file must
# remain on local or persistent block storage; S3 stores validated snapshots.
FINBOT_S3_BACKUP_ENABLED=false
FINBOT_S3_BUCKET=
FINBOT_S3_PREFIX=finbot
FINBOT_S3_BACKUP_INTERVAL_SECONDS=900
# never | if_missing | if_newer | always
FINBOT_S3_RESTORE_MODE=if_newer
FINBOT_S3_RESTORE_REQUIRED=false
FINBOT_S3_SERVER_SIDE_ENCRYPTION=AES256
FINBOT_S3_KMS_KEY_ID=
# Set only for S3-compatible services such as MinIO or Cloudflare R2.
FINBOT_S3_ENDPOINT_URL=
AWS_REGION=eu-north-1

# Optional email after an eToro demo order is acknowledged. SMTP_SECURITY is
# starttls (usually 587), tls for implicit TLS (usually 465), or none.
FINBOT_TRADE_EMAIL_ENABLED=false
FINBOT_TRADE_EMAIL_TO=
FINBOT_TRADE_EMAIL_ATTACH_JSON=true
FINBOT_TRADE_EMAIL_SUBJECT_PREFIX=[Finbot]
FINBOT_SMTP_HOST=
FINBOT_SMTP_PORT=587
FINBOT_SMTP_SECURITY=starttls
FINBOT_SMTP_USERNAME=
FINBOT_SMTP_PASSWORD=
FINBOT_SMTP_FROM=
FINBOT_SMTP_TIMEOUT_SECONDS=20
